# EVCC grid-control audit collector defaults
# Copy to /etc/evcc-grid-control-audit.env and adjust locally.
# This is a systemd EnvironmentFile, not a shell script.

EVCC_BASE_URL=http://127.0.0.1:7070
VM_WRITE_URL=http://127.0.0.1:8428/api/v1/import/prometheus
SITE_ID=home
EVCC_API_POLL_SECONDS=10
HTTP_TIMEOUT_SECONDS=10

# Local cumulative CSV for intervention events. Set LOCAL_EVENT_CSV=false to disable.
AUDIT_DATA_DIR=/var/lib/evcc-grid-control-audit
LOCAL_EVENT_CSV=true

# Optional: explicitly list controllable groups for the Daily Details grid-control tab.
# The collector does not infer controllable groups from EVCC names.
# Syntax: id|display name|kind|members;id2|display name|kind|members2
# Supported kinds:
# - loadpoint/loadpoints, members are EVCC loadpoint indices, e.g. 1 or 1+2
# - heat_pump, members are EVCC loadpoint indices for heat pumps represented as loadpoints
# - battery_grid_charge, members can stay empty
# EVCC_14A_CONTROL_GROUPS=wallbox1|Carport Corner|loadpoint|1;wallbox2|Carport Stairs|loadpoint|2;wp1|Heat pump|heat_pump|3;battery|Battery grid charge|battery_grid_charge|

# Optional: override the number of controllable units for the minimum allowed power calculation.
# If unset, the collector uses the number of configured EVCC_14A_CONTROL_GROUPS.
# EVCC_14A_CONTROL_UNITS=4
EVCC_14A_MIN_POWER_BASE_W=4200
EVCC_14A_ADDITIONAL_UNIT_FACTOR=0.4
