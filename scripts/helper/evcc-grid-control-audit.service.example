[Unit]
Description=EVCC grid-control audit collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/evcc-grid-control-audit.env
ExecStart=/usr/bin/python3 /opt/evcc-vm-migration/collect-evcc-grid-control-audit.py
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
