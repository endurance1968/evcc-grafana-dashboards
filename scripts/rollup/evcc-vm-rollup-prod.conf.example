[victoriametrics]
base_url = http://192.168.1.160:8428
host_label =
timezone = Europe/Berlin
metric_prefix = evcc
raw_sample_step = 10s
energy_rollup_step = 60s
price_bucket_minutes = 15
# Regex for former EXT titles that continue under the same Consumer title. Consumer wins on overlap.
consumer_legacy_ext_regex = ^$
# Optional JSON aliases for renamed Consumer titles, for example {"Old title":"Current title"}.
consumer_title_aliases_json = {}
max_fetch_points_per_series = 28000

[benchmark]
start = 2026-02-20T00:00:00Z
end = 2026-03-22T00:00:00Z
step = 1d
